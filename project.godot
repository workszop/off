; Engine configuration file.

config_version=5

[application]

config/name="Offquarium"
config/description="An office aquarium: a paper-diorama office whose cast lives by the real clock."
run/main_scene="res://scenes/office.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom_font="res://assets/fonts/Inter-Variable.woff2"

[rendering]

anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
environment/defaults/default_clear_color=Color(0.957, 0.937, 0.898, 1)
